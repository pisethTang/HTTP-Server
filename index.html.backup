<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Titan - High-Performance C++ HTTP Server</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica', 'Arial', sans-serif;
            background: #f5f5f5;
            color: #24292e;
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .header {
            text-align: center;
            background: white;
            border-bottom: 3px solid #0366d6;
            padding: 40px 20px;
            margin-bottom: 30px;
        }
        
        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            color: #24292e;
            font-weight: 600;
        }
        
        .header .subtitle {
            font-size: 1.1em;
            color: #586069;
        }
        
        .tech-badge {
            display: inline-block;
            background: #f1f8ff;
            border: 1px solid #c8e1ff;
            color: #0366d6;
            padding: 6px 12px;
            margin: 5px;
            border-radius: 3px;
            font-size: 0.85em;
            font-weight: 500;
        }
        
        .stats-section {
            background: white;
            border: 1px solid #e1e4e8;
            border-radius: 6px;
            padding: 30px;
            margin-bottom: 20px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .stat-card {
            background: white;
            border: 1px solid #e1e4e8;
            padding: 20px;
            border-radius: 6px;
            text-align: center;
        }
        
        .stat-value {
            font-size: 2.5em;
            font-weight: 600;
            display: block;
            color: #0366d6;
        }
        
        .stat-label {
            font-size: 0.9em;
            color: #586069;
            margin-top: 5px;
        }
        
        .demo-section {
            background: white;
            border: 1px solid #e1e4e8;
            border-radius: 6px;
            padding: 30px;
            margin-bottom: 20px;
        }
        
        .demo-section h2 {
            color: #24292e;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 1.5em;
        }
        
        .info-box {
            background: #f6f8fa;
            border-left: 3px solid #0366d6;
            padding: 15px;
            margin: 15px 0;
            border-radius: 3px;
        }
        
        .info-box strong {
            color: #0366d6;
        }
        
        textarea, input[type="text"] {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            resize: vertical;
        }
        
        textarea:focus, input[type="text"]:focus {
            outline: none;
            border-color: #0366d6;
        }
        
        
        button {
            background: #2ea44f;
            color: white;
            border: 1px solid rgba(27, 31, 35, 0.15);
            padding: 10px 24px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s;
            margin: 5px;
        }
        
        button:hover {
            background: #2c974b;
        }
        
        button.danger {
            background: #d73a49;
        }
        
        button.danger:hover {
            background: #cb2431;
        }
        
        .response-area {
            background: #f8f9fa;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            padding: 15px;
            margin-top: 15px;
            font-family: 'Courier New', monospace;
            white-space: pre-wrap;
            max-height: 200px;
            overflow-y: auto;
        }
        
        .success {
            color: #28a745;
            font-weight: bold;
        }
        
        .error {
            color: #dc3545;
            font-weight: bold;
        }
        
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #e1e4e8;
            border-top: 3px solid #0366d6;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .tech-card {
            background: white;
            border: 1px solid #e1e4e8;
            padding: 20px;
            border-radius: 6px;
            border-left: 3px solid #0366d6;
        }
        
        .tech-card h3 {
            color: #24292e;
            margin-bottom: 10px;
            font-size: 1.1em;
            font-weight: 600;
        }
        
        .cookie-display {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 10px;
            border-radius:6f8fa;
            padding: 3px 6px;
            border-radius: 3px;
            font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', 'Menlo', monospace;
            color: #24292e;
            border: 1px solid #e1e4e8;
            font-size: 0.9em
        } 4px;
            font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', 'Menlo', monospace;
            font-size: 0.9em;
        }
        
        code {
            background: #f6f8fa;
            padding: 3px 6px;
            border-radius: 3px;
            font-family: 'SFMono-Regular', 'Consolas', 'Liberation Mono', 'Menlo', monospace;
            color: #24292e;
            border: 1px solid #e1e4e8;
            font-size: 0.9emTP Server</h1>
            <p class="subtitle">High-Performance Event-Driven Web Server Built From Scratch in C++</p>
            <div style="margin-top: 20px;">
                <span class="tech-badge">🔧 Raw Linux Syscalls</span>
                <span class="tech-badge">⚡ epoll (O(1) I/O)</span>
                <span class="tech-badge">🧵 Thread Pool</span>
                <span class="tech-badge">🚀 Zero-Copy Transfer</span>
                <span class="tech-badge">🐍 CGI Support</span>
            </div>
        </div>

        <!-- Real-Time Stats -->
        <div class="stats-section">
            <h2>📊 Live Server Statistics</h2>
            <div class="info-box">
                <strong>What's happening:</strong> These metrics update every 2 seconds by polling the <code>/stats</code> JSON endpoint. 
                The server tracks active connections using <code>epoll</code> and handles requests via a 4-thread pool.
            </div>
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-value" id="total-requests">0</span>
                    <span class="stat-label">Total HTTP Requests</span>
                    <p style="font-size: 0.8em; color: #6a737d; margin-top: 8px;">Cumulative count of all GET/POST/DELETE requests handled since server start</p>
                </div>
                <div class="stat-card">
                    <span class="stat-value" id="active-connections">0</span>
                    <span class="stat-label">Active Connections</span>
                    <p style="font-size: 0.8em; color: #6a737d; margin-top: 8px;">Live TCP sockets currently tracked by epoll (includes keep-alive)</p>
                </div>
                <div class="stat-card">
                    <span class="stat-value">4</span>
                    <span class="stat-label">Worker Threads</span>
                    <p style="font-size: 0.8em; color: #6a737d; margin-top: 8px;">Pre-allocated threads in the pool handling blocking I/O operations</p>
                </div>
                <div class="stat-card">
                    <span class="stat-value">2000+</span>
                    <span class="stat-label">Stress Test Proven</span>
                    <p style="font-size: 0.8em; color: #6a737d; margin-top: 8px;">Simultaneous connections handled in load test (C10k = 10,000 concurrent users)</p>
                </div>
            </div>
        </div>

        <!-- Feature Demo 1: File Upload -->
        <div class="demo-section">
            <h2>📤 Feature #1: HTTP POST & File Upload</h2>
            <div class="info-box">
                <strong>Systems Concept:</strong> Demonstrates HTTP request parsing, POST body extraction, and file I/O using <code>ofstream</code>.
                Data is written to disk and persisted in <code>uploaded_data.txt</code>.
            </div>
            <textarea id="upload-content" rows="4" placeholder="Type anything here... (Try JSON, code snippets, or text)">{"message": "Testing HTTP POST from browser", "timestamp": "2026-02-08"}</textarea>
            <br><br>
            <button onclick="uploadFile()">📤 Upload to Server</button>
            <div id="upload-response" class="response-area" style="display:none;"></div>
        </div>

        <!-- Feature Demo 2: CGI Execution -->
        <div class="demo-section">
            <h2>🐍 Feature #2: CGI (Common Gateway Interface)</h2>
            <div class="info-box">
                <strong>Systems Concept:</strong> This triggers <code>fork()</code>, <code>execve()</code>, and <code>pipe()</code> syscalls to execute 
                <code>time_server.py</code> as a child process. The output is captured via inter-process communication and returned as HTML.
                <br><strong>Warning:</strong> This demo intentionally includes a 10-second <code>sleep()</code> to show the thread pool handling blocking I/O without freezing the server.
            </div>
            <button onclick="executeCGI()">🐍 Run Python Script (10s blocking demo)</button>
            <div id="cgi-response" class="response-area" style="display:none;"></div>
        </div>

        <!-- Feature Demo 3: File Deletion -->
        <div class="demo-section">
            <h2>🗑️ Feature #3: HTTP DELETE Method</h2>
            <div class="info-box">
                <strong>Systems Concept:</strong> Implements the HTTP DELETE verb and uses <code>remove()</code> syscall to delete files from the filesystem.
                This demonstrates RESTful API implementation at a low level.
            </div>
            <input type="text" id="delete-path" value="/uploaded_data.txt" placeholder="/filename.txt">
            <br><br>
            <button class="danger" onclick="deleteFile()">🗑️ DELETE File</button>
            <div id="delete-response" class="response-area" style="display:none;"></div>
        </div>

        <!-- Feature Demo 4: Session Management -->
        <div class="demo-section">
            <h2>🍪 Feature #4: HTTP Cookies & Session Management</h2>
            <div class="info-box">
                <strong>Systems Concept:</strong> The server manually parses and sets HTTP <code>Set-Cookie</code> headers for stateful session tracking.
                This demonstrates understanding of HTTP's stateless nature and client-side storage.
            </div>
            <button onclick="checkCookies()">🍪 Check My Session</button>
            <div id="cookie-display" class="cookie-display" style="display:none;"></div>
        </div>

        <!-- Technical Architecture -->
        <div class="demo-section">
            <h2>🏗️ How This Compares to Production Servers</h2>
            
            <div class="info-box" style="margin-bottom: 20px;">
                <strong>Context:</strong> This is a <strong>HTTP/1.1 web server</strong> — the same category as <strong>nginx</strong>, <strong>Apache</strong>, and the HTTP layer inside <strong>Node.js</strong>. 
                It accepts TCP connections, parses HTTP requests, serves files, and executes backend scripts.
                <br><br>
                <strong>What makes this different:</strong> Most developers use high-level libraries (Express.js, Flask, Spring Boot) that <em>hide</em> how HTTP actually works. 
                This implementation exposes the raw Linux kernel APIs that <em>all</em> servers ultimately rely on.
            </div>

            <h3 style="margin-top: 25px; margin-bottom: 15px; color: #24292e;">📚 Technical Implementation Breakdown</h3>
            
            <div class="tech-card" style="margin-bottom: 15px;">
                <h3>🔧 epoll Event Loop (Like Node.js's libuv, Redis's Event Loop)</h3>
                <p style="margin-bottom: 10px;">
                    <strong>What it does:</strong> Monitors thousands of network sockets simultaneously without blocking the CPU.
                </p>
                <p style="margin-bottom: 10px;">
                    <strong>How it works:</strong> Uses Linux's <code>epoll_wait()</code> syscall in <strong>edge-triggered mode</strong>. 
                    When data arrives on any socket, the kernel wakes up the process instantly. O(1) complexity — unlike <code>select()</code> which is O(n).
                </p>
                <p style="color: #6a737d; font-size: 0.9em;">
                    <strong>Real-world equivalent:</strong> nginx uses epoll. Node.js uses libuv (which wraps epoll on Linux). Redis uses epoll for pub/sub.
                </p>
            </div>

            <div class="tech-card" style="margin-bottom: 15px;">
                <h3>🧵 Thread Pool Pattern (Like Apache Worker MPM, NGINX + FastCGI)</h3>
                <p style="margin-bottom: 10px;">
                    <strong>What it does:</strong> Pre-allocates 4 worker threads to handle slow operations (disk I/O, script execution) without freezing the main event loop.
                </p>
                <p style="margin-bottom: 10px;">
                    <strong>How it works:</strong> Producer-Consumer pattern using <code>std::mutex</code> and <code>std::condition_variable</code>. 
                    Tasks are queued, and idle threads pick them up. Avoids the overhead of <code>fork()</code>-ing a new process per request (like old CGI).
                </p>
                <p style="color: #6a737d; font-size: 0.9em;">
                    <strong>Real-world equivalent:</strong> Apache's Worker MPM uses threads. Node.js offloads file I/O to a thread pool. Databases like PostgreSQL use background workers.
                </p>
            </div>

            <div class="tech-card" style="margin-bottom: 15px;">
                <h3>⚡ Zero-Copy Transfer with sendfile() (Like nginx, Kafka)</h3>
                <p style="margin-bottom: 10px;">
                    <strong>What it does:</strong> Streams files from disk to network socket without copying data into user-space memory.
                </p>
                <p style="margin-bottom: 10px;">
                    <strong>How it works:</strong> Traditional I/O: <code>read(file) → copy to buffer → write(socket)</code> (4 context switches, 2 copies). 
                    <code>sendfile()</code>: Kernel transfers data directly from page cache to TCP buffer (2 context switches, 0 copies).
                </p>
                <p style="color: #6a737d; font-size: 0.9em;">
                    <strong>Real-world equivalent:</strong> nginx uses sendfile for static files. Kafka uses it for log replication. CDN edge servers rely on this for performance.
                </p>
            </div>

            <div class="tech-card" style="margin-bottom: 15px;">
                <h3>🐍 CGI Process Management (Like PHP-FPM, Early Web Servers)</h3>
                <p style="margin-bottom: 10px;">
                    <strong>What it does:</strong> Executes Python scripts as separate processes and captures their output.
                </p>
                <p style="margin-bottom: 10px;">
                    <strong>How it works:</strong> Uses <code>fork()</code> to clone the server process, <code>pipe()</code> to create an IPC channel, 
                    <code>dup2()</code> to redirect stdout into the pipe, and <code>execve()</code> to replace the child process with Python. Parent reads the pipe.
                </p>
                <p style="color: #6a737d; font-size: 0.9em;">
                    <strong>Real-world equivalent:</strong> Original Apache + CGI worked this way. PHP-FPM improved it with persistent processes. Modern frameworks (Express, Flask) use in-process handlers instead.
                </p>
            </div>

            <h3 style="margin-top: 30px; margin-bottom: 15px; color: #24292e;">❌ What's Simplified (For Educational Purposes)</h3>
            <div class="info-box">
                <p style="margin-bottom: 8px;">✗ <strong>No HTTPS/TLS:</strong> Production servers use OpenSSL/mbedTLS for encryption. Adding TLS requires implementing the TLS handshake.</p>
                <p style="margin-bottom: 8px;">✗ <strong>No HTTP/2 or HTTP/3:</strong> This implements HTTP/1.1 only. HTTP/2 uses binary framing and multiplexing; HTTP/3 uses QUIC over UDP.</p>
                <p style="margin-bottom: 8px;">✗ <strong>No Virtual Hosts:</strong> Can't host multiple domains on one IP (nginx can). Would need Host header routing.</p>
                <p style="margin-bottom: 8px;">✗ <strong>No Load Balancing/Reverse Proxy:</strong> No upstream server pooling like nginx's proxy_pass.</p>
                <p style="margin-bottom: 8px;">✗ <strong>No Compression:</strong> No gzip/brotli encoding (nginx has this built-in).</p>
                <p style="margin-bottom: 8px;">✗ <strong>No Access Logs/Analytics:</strong> Production servers write to access.log, error.log with rotation.</p>
                <p>✓ <strong>What we DO have:</strong> The core event loop, concurrency model, and I/O optimization that all servers need.</p>
            </div>

            <h3 style="margin-top: 30px; margin-bottom: 15px; color: #24292e;">💡 Why "HTTP Server" is Generic (And Why That's The Point)</h3>
            <div class="info-box">
                <p style="margin-bottom: 10px;">
                    An <strong>HTTP server</strong> is just software that speaks the HTTP protocol — it's not tied to any specific use case. 
                    nginx is an HTTP server (used for static files, reverse proxy). Apache is an HTTP server (used for hosting websites). 
                    Node.js <em>contains</em> an HTTP server (the <code>http</code> module). Even REST APIs are HTTP servers.
                </p>
                <p>
                    <strong>This project proves you understand the foundation all of them are built on:</strong> sockets, event loops, process/thread management, and kernel I/O primitives. 
                    The difference between this and nginx is production features (TLS, config files, modules), not the core architecture.
                </p>
            </div>
        </div>

        <!-- Footer -->
        <div style="text-align: center; color: #586069; padding: 40px 0; background: white; border: 1px solid #e1e4e8; border-radius: 6px; margin-top: 20px;">
            <p style="font-size: 1.1em; color: #24292e; font-weight: 500;">Built entirely from scratch using raw Linux syscalls - no frameworks, no libraries.</p>
            <p style="margin-top: 10px;">Solving the C10k Problem, one connection at a time. ⚡</p>
        </div>
    </div>

    <script>
        // Auto-update stats every 2 seconds
        function updateStats() {
            fetch('/stats')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('total-requests').textContent = data.requests;
                    document.getElementById('active-connections').textContent = data.active_connections;
                })
                .catch(err => console.error('Stats update failed:', err));
        }
        
        // Initial update and set interval
        updateStats();
        setInterval(updateStats, 2000);

        // File Upload Demo
        function uploadFile() {
            const content = document.getElementById('upload-content').value;
            const responseDiv = document.getElementById('upload-response');
            responseDiv.style.display = 'block';
            responseDiv.innerHTML = '<div class="loading"></div> Sending POST request...';
            
            fetch('/upload', {
                method: 'POST',
                headers: {'Content-Type': 'text/plain'},
                body: content
            })
            .then(response => response.text())
            .then(data => {
                responseDiv.innerHTML = '<span class="success">✅ SUCCESS</span>\n\n' + data;
            })
            .catch(err => {
                responseDiv.innerHTML = '<span class="error">❌ ERROR</span>\n\n' + err.message;
            });
        }

        // CGI Execution Demo
        function executeCGI() {
            const responseDiv = document.getElementById('cgi-response');
            responseDiv.style.display = 'block';
            responseDiv.innerHTML = '<div class="loading"></div> Executing Python script...\n\n⏱️ This will take 10 seconds (demonstrating non-blocking thread pool)';
            
            const startTime = Date.now();
            
            fetch('/time')
                .then(response => response.text())
                .then(data => {
                    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
                    responseDiv.innerHTML = '<span class="success">✅ CGI EXECUTED</span> (took ' + elapsed + 's)\n\n' + data;
                })
                .catch(err => {
                    responseDiv.innerHTML = '<span class="error">❌ ERROR</span>\n\n' + err.message;
                });
        }

        // File Delete Demo
        function deleteFile() {
            const path = document.getElementById('delete-path').value;
            const responseDiv = document.getElementById('delete-response');
            responseDiv.style.display = 'block';
            responseDiv.innerHTML = '<div class="loading"></div> Sending DELETE request for: ' + path;
            
            fetch(path, {method: 'DELETE'})
                .then(response => response.text())
                .then(data => {
                    responseDiv.innerHTML = '<span class="success">✅ SUCCESS</span>\n\n' + data;
                })
                .catch(err => {
                    responseDiv.innerHTML = '<span class="error">❌ ERROR</span>\n\n' + err.message;
                });
        }

        // Cookie Check Demo
        function checkCookies() {
            const cookieDiv = document.getElementById('cookie-display');
            cookieDiv.style.display = 'block';
            
            if (document.cookie) {
                cookieDiv.innerHTML = '🍪 <strong>Found Session:</strong> ' + document.cookie;
            } else {
                cookieDiv.innerHTML = '🍪 <strong>No cookies detected.</strong> The server sets "session_id" on first visit.';
            }
        }
    </script>
</body>
</html>